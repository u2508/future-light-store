# Copy this file to .env.release.local and fill in the admin credential.
# Never commit .env.release.local.
SALT_SHOP_URL=https://vs-future-store-0jl2t-jxu6tnr3.myshopify.com
FUTURE_LIGHT_STORE=1
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-07
SALT_SHOPIFY_THEME_DIR=../future-light-store-shopify
SHOPIFY_CLI_AGENT_INFO=n:future-light-store|v:1|p:openai
SALT_SHOPIFY_SYNC_ACTIVE_CATALOG=1
SALT_SHOPIFY_USE_CLI_ADMIN_PRICING=1
SALT_RECENTLY_ORDERED_PRODUCT_MINIMUM=300

# Release safety gates. Keep these disabled until the Future Light Store
# taxonomy, collection, merge, and price manifests are reviewed and approved.
SALT_CATALOG_TAXONOMY_APPROVED=0
SALT_CATALOG_TAXONOMY_APPROVAL_ID=future-light-store-taxonomy-pending
SALT_CATALOG_COLLECTIONS_APPROVED=0
SALT_CATALOG_COLLECTIONS_APPROVAL_ID=future-light-store-collections-pending
SALT_CATALOG_COLLECTION_MERGES_APPROVED=0
SALT_CATALOG_COLLECTION_MERGE_APPROVAL_ID=future-light-store-merges-pending
SALT_CATALOG_PRICE_REWORK_APPROVED=0
SALT_CATALOG_PRICE_REWORK_APPROVAL_ID=future-light-store-price-pending
SALT_REQUIRE_KNOWLEDGE_MODEL=1
SALT_CATALOG_KNOWLEDGE_EVIDENCE_PATH=output/catalog-knowledge-model-evidence.json
SALT_CATALOG_PRICE_FLOOR=35
SALT_VARIANT_COST_TOLERANCE=2
SALT_RELEASE_SKIP_MOBILE=1
