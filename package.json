{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-sitemap.ts",
    "dev": "vite dev",
    "prebuild": "node scripts/generate-sitemap.ts",
    "build": "node scripts/build-web-release.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "catalog:artifacts": "node scripts/build-product-knowledge.mjs && node scripts/build-product-search-index.mjs",
    "catalog:knowledge:model:train": "node scripts/train-catalog-knowledge-model.mjs --records 256000000 --output output/catalog-knowledge-model.json",
    "catalog:knowledge:model:verify": "node scripts/verify-catalog-knowledge-model.mjs",
    "catalog:listing-intelligence:test": "node scripts/validate-product-listing-intelligence.mjs",
    "catalog:tags:fetch": "node scripts/fetch-shopify-tag-inventory.mjs",
    "catalog:taxonomy:audit": "node scripts/build-catalog-taxonomy-audit.mjs",
    "catalog:taxonomy:validate": "node scripts/validate-catalog-taxonomy.mjs",
    "catalog:image-review:build": "node scripts/build-catalog-image-review.mjs",
    "catalog:image-review:validate": "node scripts/verify-catalog-image-coverage.mjs",
    "shopify:catalog-integrity:dry-run": "SALT_KNOWLEDGE_ACCELERATOR=auto node scripts/shopify-catalog-integrity.mjs --dry-run",
    "shopify:catalog-integrity:apply": "SALT_KNOWLEDGE_ACCELERATOR=auto node scripts/shopify-catalog-integrity.mjs --apply",
    "shopify:catalog-integrity:verify": "SALT_KNOWLEDGE_ACCELERATOR=auto node scripts/shopify-catalog-integrity.mjs --verify",
    "shopify:product-metafields:ensure": "node scripts/ensure-shopify-product-metafields.mjs",
    "shopify:price-rework:dry-run": "node scripts/shopify-price-rework.mjs --dry-run",
    "shopify:price-rework:apply": "node scripts/shopify-price-rework.mjs --apply",
    "shopify:price-rework:verify": "node scripts/shopify-price-rework.mjs --verify --verify-manifest output/shopify-price-rework-manifest.json",
    "shopify:variant-cost-price:dry-run": "node scripts/shopify-variant-cost-price-alignment.mjs --dry-run",
    "shopify:variant-cost-price:apply": "node scripts/shopify-variant-cost-price-alignment.mjs --apply",
    "shopify:variant-cost-price:verify": "node scripts/shopify-variant-cost-price-alignment.mjs --verify",
    "shopify:variant-image-mapping:dry-run": "node scripts/shopify-variant-image-mapping.mjs --dry-run",
    "shopify:variant-image-mapping:apply": "node scripts/shopify-variant-image-mapping.mjs --apply --resume",
    "shopify:seo:release": "node scripts/shopify-seo-guarded-apply.mjs",
    "shopify:seo:local-review": "node scripts/shopify-seo-local-review.mjs",
    "shopify:taxonomy:dry-run": "node scripts/shopify-catalog-taxonomy-apply.mjs --dry-run",
    "shopify:taxonomy:apply": "node scripts/shopify-catalog-taxonomy-apply.mjs --apply",
    "seo:new-products:apply": "node scripts/shopify-seo-pipeline.mjs --apply --scope new-products",
    "shopify:products:zero-images:apply": "node scripts/shopify-delete-zero-image-products.mjs --apply",
    "shopify:publications:all:apply": "node scripts/shopify-publish-active-products.mjs --apply",
    "shopify:product-metafields:backfill:all-active": "node scripts/shopify-product-metafield-backfill.mjs --apply --all-active",
    "shopify:product-specificity:verify": "node scripts/verify-shopify-product-specificity.mjs",
    "shopify:merchandising:verify": "node scripts/verify-shopify-merchandising.mjs",
    "shopify:collection-merges:dry-run": "node scripts/shopify-collection-merges-apply.mjs --dry-run",
    "shopify:collection-merges:apply:approved": "SALT_CATALOG_COLLECTION_MERGES_APPROVED=1 node scripts/shopify-collection-merges-apply.mjs --apply",
    "shopify:tag-collection-cleanup:snapshot": "SALT_CLEANUP_LOCAL_ONLY=1 node scripts/shopify-tag-collection-cleanup.mjs --snapshot",
    "shopify:tag-collection-cleanup:dry-run": "SALT_CLEANUP_LOCAL_ONLY=1 node scripts/shopify-tag-collection-cleanup.mjs --dry-run",
    "shopify:tag-collection-cleanup:apply": "SALT_CLEANUP_LOCAL_ONLY=1 node scripts/shopify-tag-collection-cleanup.mjs --apply",
    "shopify:variant-seo:verify": "node scripts/verify-shopify-variant-seo.mjs",
    "shopify:collections:shuffle:dry-run": "node scripts/shopify-collection-shuffle.mjs --dry-run",
    "shopify:collections:shuffle:apply": "node scripts/shopify-collection-shuffle.mjs --apply",
    "shopify:collections:shuffle:verify": "node scripts/shopify-collection-shuffle.mjs --verify",
    "sync:data": "node scripts/sync-shopify-data.mjs && node scripts/sync-dependent-shopify-data.mjs",
    "build:web:release": "npm run catalog:artifacts && node scripts/build-web-release.mjs",
    "theme:bundle:release": "node scripts/build-shopify-theme.mjs",
    "release": "node scripts/run-future-light-release.mjs --profile daily",
    "release:daily": "node scripts/run-future-light-release.mjs --profile daily",
    "release:resume": "node scripts/run-future-light-release.mjs --resume",
    "release:daily:resume": "node scripts/run-future-light-release.mjs --profile daily --resume"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
